{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "environments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mysqlCidrs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^10\\.0\\.(?:[0-9]{1,2}|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]{1,2}|1[0-9]{2}|2[0-4][0-9]|25[0-5])/32$"
            }
          },
          "qdrantCidrs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^10\\.0\\.(?:[0-9]{1,2}|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]{1,2}|1[0-9]{2}|2[0-4][0-9]|25[0-5])/32$"
            }
          }
        }
      }
    },
    "secretStores": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "pattern": "^([0-9]{12})?$"
        }
      }
    }
  }
}
