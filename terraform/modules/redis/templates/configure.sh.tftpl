#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
set +x
export AWS_DEFAULT_REGION='${aws_region}'
export AWS_PAGER=''
# Rotation version ${password_version}; secret is retrieved only on the host.
cloud-init status --wait >/dev/null
exec 9>/run/zipsai-redis-configure.lock
flock -w 300 9
username="$(aws ssm get-parameter --name '${username_parameter}' --query Parameter.Value --output text)"
password="$(aws ssm get-parameter --name '${password_parameter}' --with-decryption --query Parameter.Value --output text)"
[[ "$username" =~ ^[A-Za-z0-9_-]+$ ]] || exit 1
[[ -n "$password" && "$password" != *$'\n'* && "$password" != *$'\r'* ]] || exit 1
[[ $${#password} -ge 16 && $${#password} -le 128 ]] || { echo 'Redis password must be 16 to 128 characters.' >&2; exit 1; }
password_hash="$(printf '%s' "$password" | sha256sum | cut -d ' ' -f 1)"
image='redis:${image_version}'
docker pull "$image"
redis_uid="$(docker run --rm --entrypoint id "$image" -u redis)"
redis_gid="$(docker run --rm --entrypoint id "$image" -g redis)"
config_dir=/opt/zipsai-redis/config
install -d -m 0750 -o "$redis_uid" -g "$redis_gid" "$config_dir"
stage_dir="$(mktemp -d /opt/zipsai-redis/config-stage.XXXXXX)"
trap 'unset password password_hash; rm -f "$stage_dir/users.acl" "$stage_dir/redis.conf"; rmdir "$stage_dir"' EXIT
if [[ "$username" != default ]]; then
  printf 'user default off\n' > "$stage_dir/users.acl"
else
  : > "$stage_dir/users.acl"
fi
printf 'user %s on #%s ~* &* +@all\n' "$username" "$password_hash" >> "$stage_dir/users.acl"
printf '%s\n' 'bind 0.0.0.0' 'port 6379' 'protected-mode yes' \
  'save ""' 'appendonly no' 'maxmemory ${maxmemory_mib}mb' \
  'maxmemory-policy noeviction' 'aclfile /usr/local/etc/redis/users.acl' \
  > "$stage_dir/redis.conf"
# No-op association reruns must not clear temporary state.
current_image="$(docker inspect --format '{{.Config.Image}}' zipsai-redis 2>/dev/null || true)"
running="$(docker inspect --format '{{.State.Running}}' zipsai-redis 2>/dev/null || true)"
if [[ "$current_image" != "$image" || "$running" != true ]] || \
   ! cmp -s "$stage_dir/redis.conf" "$config_dir/redis.conf" || \
   ! cmp -s "$stage_dir/users.acl" "$config_dir/users.acl"; then
  install -m 0640 -o "$redis_uid" -g "$redis_gid" "$stage_dir/users.acl" "$config_dir/users.acl"
  install -m 0640 -o "$redis_uid" -g "$redis_gid" "$stage_dir/redis.conf" "$config_dir/redis.conf"
  # Single Redis: settings/image/credential updates cause a short interruption.
  if docker container inspect zipsai-redis >/dev/null 2>&1; then
    docker stop --time 30 zipsai-redis >/dev/null
    docker rm -v zipsai-redis >/dev/null
  fi
  docker run -d --name zipsai-redis --restart unless-stopped \
    --publish 6379:6379 \
    --mount "type=bind,src=$config_dir,dst=/usr/local/etc/redis,readonly" \
    --log-driver awslogs --log-opt awslogs-region='${aws_region}' \
    --log-opt awslogs-group='${log_group}' --log-opt awslogs-stream=redis \
    "$image" redis-server /usr/local/etc/redis/redis.conf >/dev/null
fi
# Password is passed through stdin, never in arguments or persistent container environment.
for attempt in $(seq 1 30); do
  if printf '%s\n' "$password" | docker exec -i zipsai-redis sh -c \
    'IFS= read -r REDISCLI_AUTH; export REDISCLI_AUTH; exec redis-cli --user "$1" ping' sh "$username" \
    | grep -qx PONG; then
    echo 'Redis authenticated PING succeeded.'
    exit 0
  fi
  sleep 2
done
echo 'Redis authenticated readiness check failed.' >&2
exit 1
