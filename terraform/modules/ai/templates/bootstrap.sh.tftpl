#!/usr/bin/env bash
set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl unzip python3 docker.io docker-compose-v2
systemctl enable --now docker
if ! command -v aws >/dev/null 2>&1; then
  ai_bootstrap_dir="$(mktemp -d)"
  curl -fsS --retry 5 https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o "$ai_bootstrap_dir/awscliv2.zip"
  unzip -q "$ai_bootstrap_dir/awscliv2.zip" -d "$ai_bootstrap_dir"
  "$ai_bootstrap_dir/aws/install"
fi
if ! snap list amazon-ssm-agent >/dev/null 2>&1; then snap install amazon-ssm-agent --classic; fi
snap start amazon-ssm-agent
data_volume_id='${data_volume_id}'
if [[ -n "$data_volume_id" ]]; then
  data_device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$data_volume_id"
  for attempt in $(seq 1 120); do
    [[ -b "$data_device" ]] && break
    sleep 5
  done
  [[ -b "$data_device" ]] || { echo 'Qdrant data disk missing' >&2; exit 1; }
  if ! blkid "$data_device" >/dev/null 2>&1; then mkfs.ext4 -F "$data_device"; fi
  data_uuid="$(blkid -s UUID -o value "$data_device")"
  install -d -m 0755 /data
  if ! grep -q "^UUID=$data_uuid " /etc/fstab; then
    printf 'UUID=%s /data ext4 defaults,nofail,x-systemd.device-timeout=10min 0 2\n' "$data_uuid" >> /etc/fstab
  fi
  mountpoint -q /data || mount /data
  mountpoint -q /data || exit 1
  install -d -m 0755 /data/qdrant
fi
# Applications are started explicitly by CD/SSM, not by terraform apply.
