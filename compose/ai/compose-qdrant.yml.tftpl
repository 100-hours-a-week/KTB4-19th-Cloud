services:
  qdrant:
    image: qdrant/qdrant:${qdrant_version}
    platform: linux/amd64
    restart: unless-stopped
    ports: ["6333:6333"]
    env_file: ["runtime.env"]
    environment:
      QDRANT__SERVICE__API_KEY: $${QDRANT_ADMIN_API_KEY:?Supply the existing Qdrant admin key}
      QDRANT__SERVICE__READ_ONLY_API_KEY: $${QDRANT_READ_ONLY_API_KEY:?Supply the existing read-only key}
    volumes:
      - type: bind
        source: /data/qdrant
        target: /qdrant/storage
        bind:
          create_host_path: false
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/6333"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 10s
    logging:
      driver: awslogs
      options:
        awslogs-region: ${aws_region}
        awslogs-group: ${log_group}
        awslogs-stream: qdrant
        mode: non-blocking
        max-buffer-size: 4m
